rules_version = '2';
// Firestore security rules for Late Night Happy Hour Bowling League.
// Public reads are allowed so unauthenticated visitors can view league data.
// All write operations require the requester to be authenticated via Firebase Auth.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{collection}/{document} {
      // Allow anyone (including unauthenticated users) to read any document.
      allow read: if true;
      // Allow writes only to authenticated users (admins use Firebase Auth).
      allow write: if request.auth != null;
    }
  }
}
