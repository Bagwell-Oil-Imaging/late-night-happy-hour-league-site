# Service account key for Firebase Admin SDK (used by server-side scripts only)
# 1. Go to: Firebase Console → Project Settings → Service Accounts
# 2. Click "Generate new private key" and save the downloaded JSON as service-account.json
# 3. NEVER commit service-account.json — it is already listed in .gitignore
# Required by: npm run seed (scripts/seed-firestore.js) and npm run transform
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Path to the Firebase service account JSON file used by scripts/transform-data.js
# to write transformed data directly to Firestore. Defaults to ./service-account.json
# if not set. The same file referenced by GOOGLE_APPLICATION_CREDENTIALS above.
# Required by: npm run transform, npm run update-data
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json

# Full contents of the Google service account JSON key, used by the Vercel
# serverless function (api/upload-to-drive.js) at runtime.
# Unlike scripts (which read a local file), Vercel has no filesystem — the
# entire JSON must be pasted as a single-line string here.
#
# How to get this value:
#   1. Open service-account.json in a text editor
#   2. Copy the entire JSON object (all lines, curly braces included)
#   3. Paste it here as a single line (remove all newlines), or set it as a
#      multi-line secret in the Vercel dashboard (Vercel handles quoting for you)
#
# Used by: api/upload-to-drive.js (Vercel serverless Drive upload endpoint)
# NEVER commit the real value — it contains private key material.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id","private_key_id":"your-key-id","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"your-service-account@your-project-id.iam.gserviceaccount.com","client_id":"your-client-id","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/your-service-account%40your-project-id.iam.gserviceaccount.com"}

# Google Drive folder IDs — used by scripts and admin UI for file storage
# Root folder shared with the service account in the league Google Drive
DRIVE_FOLDER_ROOT=your-root-folder-id
DRIVE_FOLDER_BYLAWS=your-bylaws-folder-id
DRIVE_FOLDER_ASSETS=your-assets-folder-id
DRIVE_FOLDER_ASSETS_CAROUSEL=your-assets-carousel-folder-id
DRIVE_FOLDER_ASSETS_GENERAL=your-assets-general-folder-id
# Season folders — add a new set each season (e.g. 2026-2027)
DRIVE_FOLDER_2024_2025=your-2024-2025-folder-id
DRIVE_FOLDER_2024_2025_WEEKLY_REPORTS=your-2024-2025-weekly-reports-folder-id
DRIVE_FOLDER_2024_2025_TEAM_PHOTOS=your-2024-2025-team-photos-folder-id
DRIVE_FOLDER_2024_2025_IMAGES=your-2024-2025-images-folder-id
DRIVE_FOLDER_2025_2026=your-2025-2026-folder-id
DRIVE_FOLDER_2025_2026_WEEKLY_REPORTS=your-2025-2026-weekly-reports-folder-id
# ^ Also set this as a GitHub Actions secret: DRIVE_FOLDER_2025_2026_WEEKLY_REPORTS
# Required by: scripts/download-weekly-standings.js (weekly PDF upload to Drive)
DRIVE_FOLDER_2025_2026_TEAM_PHOTOS=your-2025-2026-team-photos-folder-id
DRIVE_FOLDER_2025_2026_IMAGES=your-2025-2026-images-folder-id

# OAuth2 credentials for Google Drive uploads (used by api/upload-to-drive.js)
#
# Service accounts cannot create files in personal Google Drives because they
# have no storage quota. OAuth2 with a stored refresh token authenticates as
# the real league Google account, which has Drive quota.
#
# Setup (one-time):
#   1. Create a "Desktop app" OAuth2 Client ID at:
#      https://console.cloud.google.com/apis/credentials
#   2. Set GOOGLE_OAUTH_CLIENT_ID and GOOGLE_OAUTH_CLIENT_SECRET below.
#   3. Run: node scripts/get-drive-oauth-token.cjs
#   4. Follow the prompts to authorize the LEAGUE Google account.
#   5. Paste the resulting token into GOOGLE_OAUTH_REFRESH_TOKEN.
#
# Note: GOOGLE_SERVICE_ACCOUNT_JSON is still required — it is used only for
# Firebase Admin SDK token verification, not for Drive uploads.
GOOGLE_OAUTH_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_OAUTH_REFRESH_TOKEN=your-offline-refresh-token

# Bylaws folder ID exposed to the browser admin UI via Vite's VITE_ prefix.
# This is the same folder as DRIVE_FOLDER_BYLAWS above; the VITE_ prefix
# makes it available to React code via import.meta.env.VITE_DRIVE_FOLDER_BYLAWS.
# The DocumentsAdmin page reads this to know where to upload bylaws PDFs.
# Value: 1yuCN8wG1V82eA24QXk84yd5_WbXFcZfk (the actual bylaws folder ID)
VITE_DRIVE_FOLDER_BYLAWS=1yuCN8wG1V82eA24QXk84yd5_WbXFcZfk

# Contact form — Formspree
# 1. Create a free account at https://formspree.io
# 2. Create a new form and copy the form ID (e.g. "xpwzabcd")
# 3. Add it here. Submissions will be forwarded to bowllatenighthappyhour@gmail.com
VITE_FORMSPREE_ID=your_formspree_form_id_here

# Firebase SDK configuration (required for Firestore and Auth)
# Copy this file to .env and fill in real values from your Firebase project console.
# NEVER commit the .env file — it contains secrets.
# Get all values from: Firebase Console > Project Settings > Your Apps > Web app config
#
# NOTE: Firebase Storage is NOT used by this project. File storage (bylaws PDFs,
# etc.) is handled by Google Drive via the Vercel serverless endpoint at
# api/upload-to-drive.js. VITE_FIREBASE_STORAGE_BUCKET is intentionally absent.

# Your Firebase project's web API key
VITE_FIREBASE_API_KEY=your-api-key-here

# The auth domain for your Firebase project (e.g. my-project.firebaseapp.com)
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com

# The Firestore project ID (matches your Firebase project name)
VITE_FIREBASE_PROJECT_ID=your-project-id

# The messaging sender ID from Firebase Cloud Messaging settings
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id

# The web app ID assigned to your Firebase app
VITE_FIREBASE_APP_ID=your-app-id
VITE_ADMIN_EMAILS=jmbagwell14@gmail.com,bowllatenighthappyhour@gmail.com
