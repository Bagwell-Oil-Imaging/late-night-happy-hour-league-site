# Service account key for Firebase Admin SDK (used by server-side scripts only)
# 1. Go to: Firebase Console → Project Settings → Service Accounts
# 2. Click "Generate new private key" and save the downloaded JSON as service-account.json
# 3. NEVER commit service-account.json — it is already listed in .gitignore
# Required by: npm run seed (scripts/seed-firestore.js) and npm run transform
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Path to the Firebase service account JSON file used by scripts/transform-data.js
# to write transformed data directly to Firestore. Defaults to ./service-account.json
# if not set. The same file referenced by GOOGLE_APPLICATION_CREDENTIALS above.
# Required by: npm run transform, npm run update-data
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json

# Contact form — Formspree
# 1. Create a free account at https://formspree.io
# 2. Create a new form and copy the form ID (e.g. "xpwzabcd")
# 3. Add it here. Submissions will be forwarded to bowllatenighthappyhour@gmail.com
VITE_FORMSPREE_ID=your_formspree_form_id_here

# Firebase SDK configuration (required for Firestore and Auth)
# Copy this file to .env and fill in real values from your Firebase project console.
# NEVER commit the .env file — it contains secrets.
# Get all values from: Firebase Console > Project Settings > Your Apps > Web app config

# Your Firebase project's web API key
VITE_FIREBASE_API_KEY=your-api-key-here

# The auth domain for your Firebase project (e.g. my-project.firebaseapp.com)
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com

# The Firestore project ID (matches your Firebase project name)
VITE_FIREBASE_PROJECT_ID=your-project-id

# The default Storage bucket (e.g. my-project.appspot.com)
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# The messaging sender ID from Firebase Cloud Messaging settings
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id

# The web app ID assigned to your Firebase app
VITE_FIREBASE_APP_ID=your-app-id
