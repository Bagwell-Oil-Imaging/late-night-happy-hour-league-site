# Contact form — Formspree
# 1. Create a free account at https://formspree.io
# 2. Create a new form and copy the form ID (e.g. "xpwzabcd")
# 3. Add it here. Submissions will be forwarded to bowllatenighthappyhour@gmail.com
VITE_FORMSPREE_ID=your_formspree_form_id_here

# Firebase — get these from Firebase Console > Project Settings > Your Apps
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
